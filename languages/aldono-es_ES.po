#. Plugin Name of the plugin
#: aldono.php
msgid "Plogins Add-Ons - Product Options for WooCommerce"
msgstr ""

#. Plugin URI of the plugin
#: aldono.php
msgid "https://plogins.com/aldono/"
msgstr "https://plogins.com/aldono/"

#. Description of the plugin
#: aldono.php
msgid ""
"Let customers add paid or free options (text, checkbox, select) to products "
"before adding to cart."
msgstr ""
"Permite que los clientes añadan opciones de pago o gratuitas (texto, casilla "
"de verificación, selección) a los productos antes de añadirlos al carrito."

#. Author of the plugin
#: aldono.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

#. Author URI of the plugin
#: aldono.php
msgid "https://wppoland.com"
msgstr "https://wppoland.com"

#: aldono.php:48
msgid ""
"Add-Ons, Product Options for WooCommerce requires WooCommerce to be active."
msgstr ""
"Complementos: las opciones de producto para WooCommerce requieren que "
"WooCommerce esté activo."

